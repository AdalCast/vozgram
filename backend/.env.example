# ---- Telegram (MTProto / GramJS) -------------------------------------------
# Sacalos de https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Lo genera `npm run login`. ES TU CUENTA ENTERA. Nunca a git, nunca a nadie.
TG_SESSION=

# ---- Soniox ----------------------------------------------------------------
# Clave madre. NUNCA sale de este archivo: el server acuña claves temporales.
SONIOX_API_KEY=

# ---- App -------------------------------------------------------------------
# Secreto compartido con la app de los lentes. Sin esto, cualquiera en internet
# puede acuñar claves (te cuesta plata) o mandar mensajes como vos.
APP_SECRET=
PORT=8787
# Origen del WebView de la Even App. '*' solo para depurar.
CORS_ORIGIN=*
